#: djaopsp/api/newsfeed.py:311
msgid "Pro-actively shared responses"
msgstr "Réponses partagées de manière proactive"

#: djaopsp/api/newsfeed.py:312
#, python-format
msgid ""
"The supplier pro-actively shared their responses%(campaign)s up to %(ends_at)s with *$%(grantee)s*.\n"
"\n"
"Click **Accept** to add the supplier to the [track dashboard](%(portfolio_track)s)\n"
"\n"
"Click **Ignore** to discard these responses."
msgstr ""
"Le fournisseur a partagé de manière proactive ses réponses%(campaign)s jusqu'au %(ends_at)s avec *$%(grantee)s*.\n"
"\n"
"Cliquez sur **Accepter** pour ajouter le fournisseur au [tableau de bord de suivi].(%(portfolio_track)s)\n"
"\n"
"Cliquez sur **Ignorer** pour rejeter ces réponses."

#: djaopsp/api/newsfeed.py:317
#, python-format
msgid " to %(campaign_title)s"
msgstr "à %(campaign_title)s"

#: djaopsp/api/newsfeed.py:392
#, python-format
msgid "*$%(account)s* completed a request from *$%(grantee)s* to respond to %(campaign)s on %(at_time)s."
msgstr "*$%(account)s* a honoré une demande de *$%(grantee)s* visant à répondre à %(campaign)s le %(at_time)s."

#: djaopsp/api/newsfeed.py:405
#, python-format
msgid ""
"\n"
"\n"
"The supplier hasn't shared the response with *$%(grantee)s* yet. Please remind the supplier to do so in order to access their answers."
msgstr ""
"\n"
"\n"
"Le fournisseur n'a pas encore communiqué la réponse à *$%(grantee)s*. Veuillez lui rappeler de le faire afin que vous puissiez accéder à ses réponses."

#: djaopsp/api/newsfeed.py:411
#, python-format
msgid "Completed request for %(campaign)s"
msgstr "Demande terminée pour %(campaign)s"

#: djaopsp/api/newsfeed.py:435
#, python-format
msgid "Completed response for %(campaign)s"
msgstr "Réponse terminée pour %(campaign)s"

#: djaopsp/api/newsfeed.py:439
#, python-format
msgid ""
"*$%(account)s* completed a response to %(campaign)s on %(last_completed_at)s.\n"
"\n"
"*$%(grantee)s* hasn't requested a response from *$%(account)s* on or after %(campaign)s was updated on %(at_time)s.\n"
"\n"
"Engage the supplier if you would like to access their response."
msgstr ""
"*$%(account)s* a terminé une réponse à %(campaign)s le %(last_completed_at)s.\n"
"\n"
"*$%(grantee)s* n'a pas demandé de réponse à *$%(account)s* à partir de la date de mise à jour de %(campaign)s (%(at_time)s).\n"
"\n"
"Contactez le fournisseur si vous souhaitez accéder à sa réponse."

#: djaopsp/api/samples.py:122
msgid "sample is already frozen"
msgstr "La réponse est déjà figé."

